# Copy this file to .env and fill in real values for local development.
# In production, set these in the Vercel dashboard (Project → Settings → Environment Variables).
# Never commit the real .env — it is gitignored.

# Anthropic API key. Used ONLY by the serverless function (server-side).
# It never reaches the browser. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret that gates the /api/generate-meals endpoint.
# APP_SECRET (server) and VITE_APP_SECRET (client) MUST be the exact same value.
# Use any long random string, e.g. the output of:  openssl rand -hex 24
APP_SECRET=replace-with-a-long-random-string
VITE_APP_SECRET=replace-with-a-long-random-string
